<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>MemberOrder.Lint</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Nullable>disable</Nullable>
    <EnableDefaultItems>false</EnableDefaultItems>
  </PropertyGroup>
  <ItemGroup>
    <Reference
      Include="UnityEngine.CoreModule"
      Condition="Exists('$(UnityManagedAssembliesPath)/UnityEngine.CoreModule.dll')"
    >
      <HintPath>$(UnityManagedAssembliesPath)/UnityEngine.CoreModule.dll</HintPath>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <Compile Include="Assets/Scripts/**/*.cs" />
    <Compile Include="Assets/Editor/**/*.cs" />
    <Compile Include="Assets/Tests/**/*.cs" />
    <Compile Include="Tools/Rebellion.Analyzers/*.cs" />
    <Compile Include="Tools/Rebellion.Analyzers.Tests/*.cs" />
  </ItemGroup>
</Project>
